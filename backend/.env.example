# Copy this file to  backend/.env  and fill it in. NEVER commit .env or put it in a zip.

# --- server ---
PORT=5000
NODE_ENV=production
# behind a host / proxy (Render, Railway, Nginx...) set 1 so the login limit sees the real visitor
TRUST_PROXY=1

# --- login security (REQUIRED in production) ---
# a long random text, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# usernames (comma separated) of the admin teacher(s): same pages as every teacher, plus they can
# edit the fixed / public learning content and see the public students (PUBLIC/0000)
ADMIN_USERNAMES=
# optional: if teacher sign-up gets abused, set a code and give it only to real teachers
TEACHER_SIGNUP_CODE=

# --- database: ONE address ... ---
# DATABASE_URL=mysql://user:password@host:3306/sejarahwira_db
# ... or separate settings ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sejarahwira_db
# hosted MySQL usually needs encryption: true  (insecure = test only)
DB_SSL=
DB_POOL=10

# only if the web pages are hosted on a DIFFERENT address than this server
# CORS_ORIGIN=https://your-site.example
# true = hanya admin boleh ubah kandungan tetap (guru lain hanya menulis NOTA GURU). WAJIB true semasa hosting.
CONTENT_ADMIN_ONLY=true
ENABLE_SIGNUP=true
# Guru mendaftar dengan e-mel dan kod pengesahan yang dihantar ke e-mel itu (perlu SMTP di bawah).
# Pilihan: hadkan domain e-mel guru, dipisah dengan koma. Kosong = semua domain.
TEACHER_EMAIL_DOMAINS=
# Pilihan: kod rahsia yang anda beri kepada guru tertentu untuk LANGKAU pengesahan e-mel (kosong = tiada laluan ini).

# E-mel untuk "Lupa kata laluan" (kod dihantar ke e-mel yang didaftarkan). Kosongkan jika belum ada.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# alamat laman anda, untuk pautan dalam e-mel, contoh http://localhost:3000
APP_URL=
